{
  "name": "conduct-risk-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:ui": "vite build",
    "deploy": "npm run build:ui && wrangler deploy",
    "typecheck": "tsc --noEmit",
